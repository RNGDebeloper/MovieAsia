# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Ottfree

# Server-only TMDB v4 API Read Access Token. Never prefix this with NEXT_PUBLIC_.
TMDB_API_TOKEN=

# Admin (required for production admin login)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional features
MAINTENANCE_MODE=false
NEXT_PUBLIC_MAINTENANCE_MESSAGE=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_DEFAULT_VIDEO_SERVER=
NEXT_PUBLIC_DISABLED_VIDEO_SERVERS=
NEXT_PUBLIC_ANNOUNCEMENT_TITLE=
NEXT_PUBLIC_ANNOUNCEMENT_MESSAGE=
NEXT_PUBLIC_ANNOUNCEMENT_LINK=
NEXT_PUBLIC_TWITTER=https://x.com
NEXT_PUBLIC_FACEBOOK=https://facebook.com
NEXT_PUBLIC_INSTAGRAM=https://instagram.com
NEXT_PUBLIC_YOUTUBE=https://youtube.com

# Ads
# Put provider-wide script/config here, without wrapping it in <script> tags.
NEXT_PUBLIC_ADS_HEAD_CODE=
# Put full ad unit markup for each placement here. Leave blank to show placeholders.
NEXT_PUBLIC_AD_TOP_BANNER_CODE=
NEXT_PUBLIC_AD_NATIVE_DISCOVERY_CODE=
NEXT_PUBLIC_AD_WATCH_TOP_CODE=
NEXT_PUBLIC_AD_WATCH_VAST_CODE=
